# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kisansarthi_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Redis Cache & Queue Locks
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=

# SMS Gateway & Provider
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=VK-EUPARJAN

# Twilio SMS Gateway Integration (Live OTP & Gate Alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TRIAL_MODE=true
TWILIO_TRIAL_MESSAGE=Your 1234 order of 1 items has shipped and should be delivered on tomorrow. Details: https://twilio.com
KISAN_SMS_TRIAL_MODE=true

# Demo / Sandbox mode: set to true only to allow sandbox verification bypass when no real OTP was issued
DEMO_MODE=false

# Frontend API Base URL (leave unset/commented out for same-origin local dev & container preview)
# VITE_API_BASE_URL=
